///|
/// Whether a MoonBit field type has a direct `@moonorm.Row` accessor, so a
/// `from_row` decoder can be generated for a model. The scalar set mirrors the
/// storage classes moonorm's `Value` models (INTEGER / TEXT / REAL / boolean).
fn is_mappable(type_ : String) -> Bool {
  match type_ {
    "Int" | "Int64" | "String" | "Double" | "Bool" => true
    _ => false
  }
}

///|
/// Whether every field of a `type` block is `from_row`-mappable.
fn all_mappable(fields : Array[Field]) -> Bool {
  for f in fields {
    if is_mappable(f.type_) == false {
      return false
    }
  }
  true
}

///|
/// The `@moonorm.Row` expression that reads column `idx` as `type_`, falling back
/// to a zero value when the column is NULL or of the wrong storage class.
fn row_accessor(type_ : String, idx : Int) -> String {
  let i = idx.to_string()
  match type_ {
    "Int64" => "(match row.int64(" + i + ") { Some(v) => v; None => 0L })"
    "Int" => "(match row.int(" + i + ") { Some(v) => v; None => 0 })"
    "String" => "(match row.text(" + i + ") { Some(v) => v; None => \"\" })"
    "Double" => "(match row.double(" + i + ") { Some(v) => v; None => 0.0 })"
    "Bool" => "(match row.int(" + i + ") { Some(v) => v != 0; None => false })"
    _ => "row.get(" + i + ")"
  }
}

///|
/// Generate a moonorm model + table descriptor for every `type` block in `spec`.
/// Each yields a MoonBit struct (its fields, from the `.api` type mapping), a
/// `<table>_table : @moonorm.Table` value carrying the snake-cased table name and
/// column list (the explicit MoonBit stand-in for SQLAlchemy's `Table(...)`,
/// which reflection would otherwise build), and — when every column has a direct
/// storage class — a `<Type>::from_row` decoder that materialises a struct from a
/// `@moonorm.Row` in projection order. The output compiles against `Lfan-ke/moonorm`.
pub fn generate_model(spec : Spec) -> String {
  let mut out = "// Code generated by moonctl. DO NOT EDIT.\n\n"
  for t in spec.types {
    out = out +
      "///|\n/// `" +
      t.name +
      "` model (generated from the `.api` `type` block).\npub(all) struct " +
      t.name +
      " {\n"
    for f in t.fields {
      out = out + "  " + f.name + " : " + f.type_ + "\n"
    }
    out = out + "}\n\n"
    let table = to_snake(t.name)
    let cols : Array[String] = []
    for f in t.fields {
      cols.push(quote(to_snake(f.name)))
    }
    out = out +
      "///|\n/// Table metadata for `" +
      t.name +
      "` — the moonorm equivalent of SQLAlchemy's `Table(...)`.\npub let " +
      table +
      "_table : @moonorm.Table = {\n  name: " +
      quote(table) +
      ",\n  columns: [" +
      commas(cols) +
      "],\n}\n\n"
    if all_mappable(t.fields) {
      out = out +
        "///|\n/// Decode a `@moonorm.Row` into a `" +
        t.name +
        "` (columns in projection order).\npub fn " +
        t.name +
        "::from_row(row : @moonorm.Row) -> " +
        t.name +
        " {\n  {\n"
      for i = 0; i < t.fields.length(); i = i + 1 {
        let f = t.fields[i]
        out = out + "    " + f.name + ": " + row_accessor(f.type_, i) + ",\n"
      }
      out = out + "  }\n}\n\n"
    }
  }
  out
}
